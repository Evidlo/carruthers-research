def make_plot(c_dict, title, fname, xlim=None):
    fig, axes = plt.subplots(4, 4, figsize=(12, 12), squeeze=False)
    date_list = dates
    for i in range(4):
        for j in range(4):
            ax = axes[i, j]
            ci = c_dict[date_list[i]]
            cj = c_dict[date_list[j]]
            if i == j:
                vals = ci[np.isfinite(ci)]
                ax.hist(vals, bins=50, color='steelblue', edgecolor='white', linewidth=0.3)
                ax.set_title(date_list[i], fontsize=11)
                ax.tick_params(axis='both', labelsize=7)
            else:
                mask = np.isfinite(ci) & np.isfinite(cj)
                x = cj[mask]
                y = ci[mask]
                if len(x) > 0:
                    ax.scatter(x, y, s=5, alpha=0.4, c='royalblue', edgecolors='none')
                    if xlim is None:
                        lo = min(x.min(), y.min())
                        hi = max(x.max(), y.max())
                        pad = (hi - lo) * 0.05 + 1e-3
                        ax.set_xlim(lo - pad, hi + pad)
                        ax.set_ylim(lo - pad, hi + pad)
                    else:
                        lo, hi = xlim
                        ax.set_xlim(lo, hi)
                        ax.set_ylim(lo, hi)
                    ax.set_aspect('equal')
                ax.set_xlabel(date_list[j], fontsize=9)
                ax.set_ylabel(date_list[i], fontsize=9)
                ax.tick_params(axis='both', labelsize=7)
    plt.suptitle(title, fontsize=14, y=1.0)
    plt.tight_layout()
    plt.savefig(f'{out_dir}/{fname}', dpi=150)
    plt.close()


def compute_pairwise_r2(c_dict):
    r2s = {}
    for i in range(4):
        for j in range(i+1, 4):
            di = c_dict[dates[i]]
            dj = c_dict[dates[j]]
            mask = np.isfinite(di) & np.isfinite(dj)
            if mask.sum() < 3:
                continue
            x, y = dj[mask], di[mask]
            mx, my = x.mean(), y.mean()
            ss_res = ((x - y) ** 2).sum()
            ss_tot = ((x - my) ** 2).sum()
            r2 = 1 - ss_res / ss_tot
            r2s[f'{dates[i]}_{dates[j]}'] = r2
    return r2s


def print_r2(c_dict, label=''):
    r2s = compute_pairwise_r2(c_dict)
    avg = sum(r2s.values()) / len(r2s)
    print(f'--- {label} ---')
    for k, v in r2s.items():
        print(f'  {k}: R^2 = {v:.4f}')
    print(f'  avg R^2 = {avg:.4f}')
    return avg


# Original scatter
orig = {d: c_all[i] for i, d in enumerate(dates)}
make_plot(orig, 'Raw c_j (top half)', '01_raw.png')
orig_r2 = print_r2(orig, 'raw')


# --- Model helpers ---
# Strategy: jointly fit (shared c' profile + per-date amplitude) to minimize
# variance of c' across dates at each column.

# We'll construct overlap across columns. For each column, collect all finite c values.
# We'll optimize shared c'[col] and per-date amplitude params.

# For each model, c_obs[col, date] = model(c_prime[col], dist[col], date_params)
# We find c_prime and date_params that minimize sum of squared residuals across all finite entries.

# To reduce free params, we treat the 'shared' 0316/0317/0319 group as potentially having
# identical c', while 0318 may need to map into that space through the distance transform.

# Let's keep it symmetric — all 4 dates share c'.

# Find columns where at least 2 dates have finite values.
finite_counts = np.zeros(N, dtype=int)
for arr in c_all:
    finite_counts += np.isfinite(arr)
overlap_cols = np.where(finite_counts >= 2)[0]

# Also full set for per-date residual evaluation
all_finite = np.zeros((4, N), dtype=bool)
for di in range(4):
    all_finite[di] = np.isfinite(c_all[di])


# We'll use the raw observed values. Let c_obs[date][col] be the observed.
# For optimization, we represent c_prime only on columns where we need it.
# Since c_prime is a shared detector property, it should exist at every column.
# But where only 1 date has data, it's underdetermined. We'll regularize with smoothness.

# Smoothness: penalize second differences of c_prime.
def smoothness_penalty(c_prime):
    return np.sum(np.diff(c_prime, 2)**2)


def fit_model(residual_fn, params0, bounds=None):
    # residual_fn(params) -> array of residuals (flattened)
    # includes smoothness regularization handled by adding penalty term
    def obj(params):
        r = residual_fn(params)
        return np.sum(r**2)
    result = minimize(obj, params0, method='L-BFGS-B', bounds=bounds)
    return result


# Shared optimizer framework:
# Params: c_prime (1024 values) + per-date amplitude offsets (3 or 4 params)
# Since c_prime is large, use L-BFGS-B with smoothness regularization.

# For tractability, we'll use a basis or just optimize directly.
# 1024 + 4 params = 1028 dims. That's fine for L-BFGS-B.

def optimize_generic(model_func, params0, bounds, label, fname, xlim=None):
    # model_func(c_prime, date_params, di) -> predicted c for date di at all cols
    # params0 = [c_prime (1024), date_params (4)]
    # bounds = bounds for concatenated params
    def residual(params):
        c_prime = params[:N]
        dp = params[N:]
        residuals = []
        for di in range(4):
            pred = model_func(c_prime, dp, di)
            mask = all_finite[di]
            residuals.append(pred[mask] - c_all[di][mask])
        # smoothness regularization
        reg_weight = 1.0
        return np.concatenate(residuals + [np.sqrt(reg_weight) * np.diff(c_prime, 2)])

    result = minimize(lambda p: np.sum(residual(p)**2), params0, method='L-BFGS-B', bounds=bounds)
    print(f"[{label}] success={result.success}, cost={result.fun:.2f}")
    c_prime_opt = result.x[:N]
    date_params_opt = result.x[N:]

    c_dict = {}
    for di, dname in enumerate(dates):
        c_dict[dname] = c_prime_opt.copy()
        pred = model_func(c_prime_opt, date_params_opt, di)
        # where original was nan, predicted should be c_prime (i.e., d=0 for date-specific params?)
        # But c_dict just stores c_prime for all dates since the model maps c_prime -> c_obs.
        # Actually for plotting c' we want the COMMON c_prime.
        pass

    c_dict = {dname: c_prime_opt for dname in dates}
    make_plot(c_dict, label, fname, xlim=xlim)
    r2 = print_r2(c_dict, label)
    return result, c_prime_opt, r2


# --- Model 1: Additive exponential ---
# c_obs = c' + a_d * exp(-dist / lam)
# Params: c_prime (1024), a_d (4 values), lam (1 value) — but to avoid identifiability issues,
# we could let lam be shared or per-date. Let's try shared lam first.
# Total: 1024 + 4 + 1 = 1029

n_params = N + 4 + 1
p0 = np.zeros(n_params)
p0[:N] = np.nanmedian(np.stack([np.where(np.isfinite(a), a, np.nan) for a in c_all]), axis=0)
p0[:N] = np.nan_to_num(p0[:N], nan=0.0)
p0[N:N+4] = 100.0
p0[N+4] = 100.0

bounds = [(-10000, 10000)] * N + [(-50000, 50000)]*4 + [(1.0, 10000.0)]

def model1(c_prime, dp, di):
    a = dp[:4]
    lam = dp[4]
    return c_prime + a[di] * np.exp(-distances[dates[di]] / lam)

r1, cp1, r2_1 = optimize_generic(model1, p0, bounds, "Model 1: c = c' + a*exp(-d/λ)", '02_model1_exp_add.png')

# --- Model 2: Multiplicative exponential ---
# c_obs = c' * (1 + a_d * exp(-dist / lam))
# params: c_prime, a_d (4), lambda

p0_2 = np.zeros(n_params)
p0_2[:N] = cp1.copy()
p0_2[N:N+4] = 0.1
p0_2[N+4] = 100.0

bounds2 = [(-10000, 10000)] * N + [(-5, 5)]*4 + [(1.0, 10000.0)]

def model2(c_prime, dp, di):
    a = dp[:4]
    lam = dp[4]
    return c_prime * (1.0 + a[di] * np.exp(-distances[dates[di]] / lam))

r2, cp2, r2_2 = optimize_generic(model2, p0_2, bounds2, "Model 2: c = c'*(1 + a*exp(-d/λ))", '03_model2_exp_mul.png')

# --- Model 3: Additive power-law ---
# c_obs = c' + a_d / (d + epsilon)^p
# params: c_prime, a_d (4), p
# use epsilon=1 to avoid singularity at d=0

epsilon = 1.0
p0_3 = np.zeros(n_params)
p0_3[:N] = cp1.copy()
p0_3[N:N+4] = 1000.0
p0_3[N+4] = 1.0

bounds3 = [(-10000, 10000)] * N + [(-1e6, 1e6)]*4 + [(0.1, 5.0)]

def model3(c_prime, dp, di):
    a = dp[:4]
    p = dp[4]
    d = distances[dates[di]] + epsilon
    return c_prime + a[di] / (d ** p)

r3, cp3, r2_3 = optimize_generic(model3, p0_3, bounds3, "Model 3: c = c' + a/(d+ε)^p", '04_model3_power_add.png')

# --- Model 4: Linear distance bias ---
# c_obs = c' + a_d * d + b_d
# But this doesn't leave c' invariant under date transform. Better:
# c_obs = c' * (1 + a_d * d)  or  c_obs = c' + a_d * d
# Let's try both.

# 4a: additive linear
p0_4a = np.zeros(N + 4 + 4)  # c_prime + a_d + b_d
c_prime_init = cp1.copy()
p0_4a[:N] = c_prime_init
p0_4a[N:N+4] = 0.0
p0_4a[N+4:N+8] = 0.0

bounds4a = [(-10000, 10000)] * N + [(-500, 500)]*4 + [(-5000, 5000)]*4

def model4a(c_prime, dp, di):
    a = dp[:4]
    b = dp[4:8]
    d = distances[dates[di]]
    return c_prime + a[di] * d + b[di]

r4a, cp4a, r2_4a = optimize_generic(model4a, p0_4a, bounds4a, "Model 4a: c = c' + a*d + b", '05_model4a_linear_add.png')

# 4b: multiplicative linear
p0_4b = np.zeros(N + 4)
p0_4b[:N] = c_prime_init
p0_4b[N:N+4] = 0.0

bounds4b = [(-10000, 10000)] * N + [(-0.01, 0.01)]*4

def model4b(c_prime, dp, di):
    a = dp[:4]
    d = distances[dates[di]]
    return c_prime * (1.0 + a[di] * d)

r4b, cp4b, r2_4b = optimize_generic(model4b, p0_4b, bounds4b, "Model 4b: c = c'*(1 + a*d)", '06_model4b_linear_mul.png')

# --- Model 5: Mixed, per-date center shift ---
# Maybe distance model is wrong? Try observed = c' + a_d * exp(-(d - shift_d)^2 / (2*sigma^2))
# Gaussian bump with per-date center/sigma

p0_5 = np.zeros(N + 4 + 4 + 1)  # c_prime + a_d + shift_d + sigma
c_prime_init = cp1.copy()
p0_5[:N] = c_prime_init
p0_5[N:N+4] = 100.0
p0_5[N+4:N+8] = 0.0  # shift relative to assumed center
p0_5[N+8] = 100.0

bounds5 = [(-10000, 10000)] * N + [(-50000, 50000)]*4 + [(-300, 300)]*4 + [(1.0, 5000.0)]

def model5(c_prime, dp, di):
    a = dp[:4]
    shift = dp[4:8]
    sigma = dp[8]
    d = distances[dates[di]] - shift[di]
    return c_prime + a[di] * np.exp(-(d**2) / (2 * sigma**2))

r5, cp5, r2_5 = optimize_generic(model5, p0_5, bounds5, "Model 5: c = c' + a*exp(-(d-shift)^2/(2σ^2))", '07_model5_gauss.png')


