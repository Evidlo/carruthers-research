geomshape = (64, 64)
outshape = (64, 64)
dynamic = False
in_dims = (None, None, 0, 0, 0, 0)
out_dims = 0
chunk_size = 1

gridshape = (50, 50, 50)
geomshape = (10, 64, 64)
outshape = (10, 64, 64)
