# # dont vmap over Ellipsis
# in_dims = (None, 0, 0, 0, 0, 0) if dynamic else (None, None, 0, 0, 0, 0)

# ----- Compute Arrays -----

x = tr.rand(gridshape, **d)
check_mem('Density tensor allocated')
geom = tr.rand((*geomshape, 3), **d)
check_mem('Viewgeom tensor allocated')

lens = tr.rand(
    (*geomshape, 2 * (gridshape[-3] + 1) + 2 * (gridshape[-2] + 1) + gridshape[-1] + 2),
    **d
)
check_mem('Lens tensor allocated')
regs = tr.randint(0, 10, (3, *lens.shape), **d)
check_mem('Regs tensor allocated')

r, e, a = regs
check_mem('Regs tensor split')
if dynamic and x.shape[0] == geom.shape[0]:
    t = tr.arange(len(x))[:, None, None, None]
else:
    t = Ellipsis


# ----- Inner Product -----

def _innerprod(x, t, r, e, a, lens):
    # print('---')
    # print('x:', x.shape)
    # print('t:', getattr(t, 'shape', 'Ellipsis'))
    # print('r:', r.shape)
    # print('e:', e.shape)
    # print('a:', a.shape)
    result = x[t, r, e, a]
    result *= lens
    result = result.sum(axis=-1)
    return result

innerprod = tr.vmap(
    _innerprod,
    in_dims=in_dims,
    out_dims=out_dims,
    chunk_size=chunk_size
)


print('---------------------------------------------')
print('grid:', tuple(gridshape))
print('geom:', geomshape)
print('dynamic:', dynamic)
print('---------------------------------------------')

print('in:', in_dims)
print('out:', out_dims)
print('x:', x.shape)
print('t:', getattr(t, 'shape', 'Ellipsis'))
print('r:', r.shape)
print('e:', e.shape)
print('a:', a.shape)

with Timer(prefix='Operator'):
    result1 = _innerprod(x, t, r, e, a, lens)
check_mem('Operator')

with Timer(prefix='VMAP Operator'):
    result2 = innerprod(x, t, r, e, a, lens)
check_mem('VMAP Operator')

assert result2.shape == outshape, f"Result shape incorrect: {result2.shape}"
assert tr.all(result1 == result2), "Mismatched VMAP result"

